# docker compose 용 환경변수. 이 파일을 .env 로 복사해서 값을 채운다.
#   cp .env.example .env

# ── 인증 ───────────────────────────────────────────────
# JWT 서명 키 (필수). 아래 명령으로 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── DB (compose의 db 서비스) ────────────────────────────
DB_ROOT_PASSWORD=1234
DB_NAME=control_system_dev
# 호스트에서 DB에 붙을 포트 (컨테이너 내부는 항상 3306)
DB_HOST_PORT=3307
# 외부 DB 를 쓸 때만 넣는다 — 위 db 서비스 대신 이 주소로 붙는다(재빌드 불필요).
#   스키마명은 APP_ENV 와 짝을 맞춘다(prod=control_system / dev=control_system_dev).
#   기동: docker compose up -d --no-deps backend mediamtx frontend
# DATABASE_URL=mysql+pymysql://계정:비밀번호@192.168.0.21:3306/control_system?charset=utf8mb4&connect_timeout=5&read_timeout=10&write_timeout=10

# ── 포트 ───────────────────────────────────────────────
BACKEND_PORT=8010
FRONTEND_PORT=3001

# ── 카메라 RTSP 전송 방식: tcp | udp ───────────────────
RTSP_TRANSPORT=tcp

# ── 로봇 네트워크 ──────────────────────────────────────
# 로봇이 붙는 망이 바뀌면(유선 로봇망 / 5G 라우터 / 로봇 자체 AP) 여기만 고친다.
# 확인 방법: ASDU heartbeat 응답이 오는 주소가 ROBOT_IP,
#            receiver.py 가 UDP 40000 을 여는 장비가 RECEIVER_IP.
ROBOT_IP=10.21.41.1
ROBOT_PORT=30000
# receiver.py 가 도는 NOS/Jetson 주소. 로봇 본체와 다른 장비다.
# Jetson 을 로봇 AP 망에 편입한 뒤 실제 할당된 IP 로 교체할 것.
RECEIVER_IP=10.21.41.1
RECEIVER_PORT=40000
# 관제 대상 robot_info.id (0 = RobotIP 로 자동 탐색). 로봇 2대 이상이면 반드시 지정.
ROBOT_ID=0

# ── 매핑 SSH: 로봇 NOS ──────────────────────────────────
# drmap 명령과 맵 디렉토리(/var/opt/robot/data/maps)가 있는 장비.
# 보통 로봇 IP 와 같은 /24 의 .106. 중계 Jetson 을 넣으면 drmap 이 없어
# 매핑이 조용히 실패하고 종료 시 "맵 디렉토리를 찾을 수 없습니다" 로 끝난다.
NOS_HOST=10.21.41.106
NOS_PORT=22
NOS_USER=
NOS_PASSWORD=

# ── 릴레이 SSH: relay_map.py 가 도는 장비 ────────────────
# 실시간 매핑 캔버스(점군/odom)를 공급하는 relay_map.py 실행 대상.
# ROS2 DDS 로 로봇 토픽이 보이면 NOS 가 아니어도 되므로 중계 Jetson 에 두는 구성이 있다.
# 비워 두면 NOS_* 를 그대로 쓴다(NOS 에서 직접 돌리는 단일 호스트 현장).
RELAY_HOST=
RELAY_PORT=22
RELAY_USER=
RELAY_PASSWORD=

# 아래 경로 3개는 릴레이 호스트 기준이다.
NOS_RELAY_SCRIPT=/opt/robot/receiver/relay_map.py
NOS_ROS2_SETUP=/opt/ros/humble/setup.bash
NOS_RELAY_LOG=/tmp/relay_map.log

# MediaMTX 의 RTSP 소스 IP 는 자동 주입되지 않는다.
# ROBOT_IP 를 바꾸면 MediaMTX/mediamtx.local.yml(compose 가 쓰는 설정)도 함께 고치고 컨테이너를 재시작할 것.
# 열화상 카메라 계정은 이 파일이 아니라 robot_vision/thermal.env 에 둔다(예시: robot_vision/thermal_env.sample).

# 음성 시나리오 API 키 (Jetson robot_voice 가 X-Voice-Key 헤더로 보낸다)
# 기계 클라이언트라 JWT 대신 고정 키를 쓴다. 유출 의심 시 값만 바꾸고
# 백엔드와 Jetson 을 재시작하면 된다. 생성: python -c "import secrets;print(secrets.token_hex(16))"
VOICE_API_KEY=

# ── docker-compose.windows.yml 용 추가 항목 ───────────────
# 이 줄이 있으면 docker compose / start.bat / stop.bat 이 windows 구성을 기본으로 쓴다.
COMPOSE_FILE=docker-compose.windows.yml
# prod=운영(control_system) / dev=개발(control_system_dev). DB_NAME 과 반드시 짝을 맞춘다.
APP_ENV=dev
RECEIVER_TCP_PORT=40001
FLOOR_TRANSITION_ASSISTED=true
# 자동 우회(경유지 끼우기)를 끌 맵 ID, 쉼표 구분 — 비우면 모든 맵에서 켬. 예: 43(관공서 3F)
AUTO_DETOUR_DISABLED_MAPS=
# 맵 관리에서 그린 구간(방향 반영)을 따라 길을 찾을 맵 ID, 쉼표 구분 — 비우면 안 씀. 예: 43(관공서 3F)
ROUTE_GRAPH_MAPS=
# 위 맵 중 직선이 뚫려 있어도 구간(경유지)을 따를 맵 ID — 예: 46(2F 주차장)
ROUTE_GRAPH_ALWAYS_MAPS=
# 통과 지점(경유지)에서 멈추지 않고 이어 간다. receiver(NOS) 실행 환경의 NAV_CONTINUE_SKIP_RESET=1 을 먼저 켤 것 —
# 관제만 켜면 경유지 1m 앞에서 멈춰 꺾는다(오히려 나빠짐)
NAV_CONTINUOUS_PASS=false
# 경유지 방향 안내("잠시 후 오른쪽으로…")를 도착 몇 초 전에 들리게 할지. 낼 거리 = 지금 속도 × (이 초 + 전달 지연), 최소 2m.
# 전달 지연 = 위치 늦음·관제 확인 주기·음성 엔진 확인 주기·재생 시작을 합친 추정값. 0 이면 예전처럼 2m 고정
NAV_CUE_LEAD_SEC=3.0
NAV_CUE_DELAY_SEC=2.5
# 출발할 때 진행 방향과 지금 방향이 이 각도(도) 이상 다르면 제자리에서 먼저 돌고 출발한다(다지점 묶음 첫 점). 0 = 끔
NAV_DEPART_TURN_DEG=45
# 안내 시작 장소 근처라 이동을 생략할 때, 장소 방향과 지금 방향이 이 각도(도) 이상 다르면 제자리에서 장소 방향으로 돌고 시작한다. 0 = 끔
GUIDE_START_FACE_DEG=20
# 서 있다가 새 이동을 시작할 때 첫 구간(로봇 → 첫 점, 3m 이하)만 저속으로 보낸다(급발진 같은 출발 완화). false = 끔
NAV_SOFT_START=true
# 노드망 다지점 주행 모드 — straight(직선, 노드 띠를 곧게) | auto(자율, 보통 최고 1.0m/s·걸으면서 회전).
# 직선은 NOS 계획기가 제자리 회전 뒤 0.1초 만에 0→1.2m/s 로 뛰어 앞바퀴가 들린다(10-29). 노드망이 꺼져 있으면 늘 자율
NODE_NAV_MODE=straight
# 자율 모드에서 이 각도(도) 이상 꺾는 통과 점은 다음 구간 방향을 줘 서서 돌게 한다(걸으며 크게 도는 반경 대응, 10-29).
# 0 이면 끔(지금처럼 걸으며 지나감). 직선 모드에는 영향 없음. 실기 비교 권장값 45
NODE_AUTO_TURN_STOP_DEG=0
# 직선 다지점 저속 보정 — 0 이면 끔. 0 보다 크면 첫 걷는 구간(거리 무관)과 앞 점에서 이 각도(도) 이상 꺾인 구간을 저속.
# 180 이면 첫 구간만. 원래 보통·고속일 때만, 단일 이동·자율 모드는 그대로(10-29)
NAV_TURN_SLOW_DEG=0
# 안내 도착 후 기본 보행으로 바꾸지 않고 내비 보행으로 서 있다가 다음 이동은 리셋 없이 출발한다(다리 재정렬 소음 감소).
# receiver(NOS) NAV_CONTINUE_SKIP_RESET=1 이 필요하다. 아래 시간 안에 출발이 안 보이면 리셋 재전송하고 그 안내 세션은 끈다.
NAV_KEEP_GAIT_ON_ARRIVAL=false
NAV_KEEP_GAIT_START_TIMEOUT_MS=6000
# 도크를 못 쓸 때(충전소 고장·배터리 분리 충전) 세워 두고 끄는 장소 이름, 쉼표 구분 — 비우면 끔.
# 끄기 전 마지막 위치가 현재 맵의 이 장소 반경·방향(30°) 안이면 켤 때 장소 좌표·방향으로 위치를 넣는다. 예: 로봇충전소-1
AUTO_INIT_POSE_PARK_PLACES=
AUTO_INIT_POSE_PARK_RADIUS_M=1.0
# 측위 상실 자동 재측위 — 미확정·제자리면 관제가 스캔을 지도 전체와 맞춰 위치를 넣는다(확정은 운영자 '완료'). 0 이면 끔
AUTO_RELOCALIZE_ENABLED=1
AGENT_TOKEN=
# MediaMTX 가 프론트와 다른 머신일 때만 지정 (빌드타임에 굽힘 → 바꾸면 frontend 재빌드)
NEXT_PUBLIC_MEDIAMTX_HOST=
# MediaMTX 설정 파일 경로 (기본: ./MediaMTX/mediamtx.local.yml)
MEDIAMTX_CONFIG=./MediaMTX/mediamtx.local.yml
# 빈 DB 최초 기동 시 기본 계정 비밀번호 (superadmin / admin / user). 덤프 이관 시 생략 가능.
SEED_SUPERADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_USER_PASSWORD=
# 안내 중 장애물 정지·멘트·자동 재개(2026-10-29). NOS 에 감지 노드(robot_receiver/obstacle_guard.py)가 떠 있어야 한다.
# ANNOUNCE: 이 초 넘게 막히면 멈춤 멘트(0 = 멈추면 바로) / SETTLE: 정지 뒤 재출발 전 대기 / STAFF: 이 초 넘게 막히면 직원 호출
# SUPPRESS_M: 운영자 '다시 출발' 뒤 이 거리(m) 동안 감지 끔(지도에 없는 의자·짐)
OBSTACLE_GUARD_ENABLED=false
# off|record|on — 감지는 안내 시나리오 이동에서만. record: 판단·기록만(실기 확인용), on: 실제 정지. 비우면 ENABLED 를 따름
OBSTACLE_GUARD_MODE=
OBSTACLE_GUARD_PORT=40100
OBSTACLE_ANNOUNCE_SEC=0
OBSTACLE_SETTLE_SEC=1.5
# ASK_AFTER: 이 초 넘게 멈췄다 풀리면 손님에게 '준비됐어요' 를 묻고 대답 뒤 출발. 시연(대본 19~21): ANNOUNCE 1.5 + ASK_AFTER 0
OBSTACLE_ASK_AFTER_SEC=30
OBSTACLE_STAFF_SEC=120
# 직원 호출 뒤 대기 안내 반복 간격(초) — 그 뒤엔 관제 처리까지 대기(자동 종료 없음, 10-30)
OBSTACLE_STAFF_REPEAT_SEC=45
# 전방 카메라 사람 인식(vision 컨테이너, robot_vision/front_person_watch.py) — 지금은 기록 단계(정지 안 함)
OBSTACLE_CAMERA_ENABLED=false
OBSTACLE_CAMERA_HOST=vision
OBSTACLE_CAMERA_PORT=40110

# 로봇 로그 수집(robotlog 컨테이너, 11-05) — 쓰는 법 tools/robotlog/robotlog.py · 보관 ./backend_logs/robot/<날짜>/
ROBOTLOG_RETENTION_DAYS=90
# 빠른 주기: NOS 우리 서비스 journal(약 8분이면 지워짐)·감지 좌표·Jetson / 느린 주기: 제조사 로그
ROBOTLOG_FAST_SEC=60
ROBOTLOG_SLOW_SEC=300
ROBOTLOG_EVENT_MAX_PER_DAY=40
# Jetson 음성 로그 — 주소와 이 PC 의 Jetson SSH 키 경로(예: C:/Users/<사용자>/.ssh/id_ed25519_jetson). 비우면 Jetson 은 수집 안 함
ROBOTLOG_JETSON_HOST=
ROBOTLOG_JETSON_USER=und02
ROBOTLOG_JETSON_KEY=
